<launch>
  <!-- Bridge to the simulator + one node per team (each node drives three robots).
       blue / red: script of that team (inside soccer/) or none -->
  <arg name="blue" default="soccer.py"/>
  <arg name="red" default="soccer.py"/>
  <include file="$(find psr_hero)/launch/bridge.launch"/>
  <node unless="$(eval arg('blue') == 'none')" pkg="psr_exercicios" type="$(arg blue)" name="soccer_blue" output="screen">
    <param name="team" value="blue"/>
  </node>
  <node unless="$(eval arg('red') == 'none')" pkg="psr_exercicios" type="$(arg red)" name="soccer_red" output="screen">
    <param name="team" value="red"/>
  </node>
</launch>
