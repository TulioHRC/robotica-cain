<launch>
  <!-- Bridge to the simulator + the avoid.py node for hero_0.
       script: another file inside avoid/ -->
  <arg name="script" default="avoid.py"/>
  <include file="$(find psr_hero)/launch/bridge.launch"/>
  <node pkg="psr_exercicios" type="$(arg script)" name="avoid_0" output="screen">
    <param name="robot" value="0"/>
  </node>
</launch>
